# AI Radio Environment Configuration
# Copy this file to .env and update with your settings

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///instance/ai_radio.db
# For PostgreSQL: postgresql://user:password@localhost/ai_radio
# For MySQL: mysql://user:password@localhost/ai_radio

# File Storage (use relative paths or absolute paths without hardcoded user directories)
UPLOAD_FOLDER=./media/uploads
MEDIA_FOLDER=./media
MAX_UPLOAD_SIZE=524288000  # 500MB in bytes
MAX_MEDIA_DURATION=3600  # 1 hour in seconds

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_DEFAULT=100 per minute

# Security
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# AI Brain (for DJ intro generation)
AI_BRAIN_URL=http://localhost:8080
AI_BRAIN_TIMEOUT=30

# Icecast Streaming Configuration
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_CONFIG=./config/icecast.xml
ICECAST_LOCATION=AI Radio Platform
ICECAST_ADMIN_EMAIL=admin@localhost
ICECAST_SOURCE_PASSWORD=ai_radio_source_2024
ICECAST_RELAY_PASSWORD=ai_radio_relay_2024
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=ai_radio_admin_2024
ICECAST_BIND_ADDRESS=0.0.0.0
ICECAST_MOUNT=/stream
ICECAST_SOURCE_USER=source
ICECAST_STREAM_NAME=AI Radio - All AI Generated Content
ICECAST_STREAM_DESCRIPTION=24/7 stream of AI-generated music, podcasts, and video content
ICECAST_STREAM_URL=http://localhost:5000
ICECAST_GENRE=AI Generated Content

# Liquidsoap Configuration
LIQUIDSOAP_CONFIG=./config/liquidsoap.liq
STREAM_URL=http://localhost:8000/stream

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/ai_radio.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Security Features
ENABLE_MALWARE_SCAN=False  # Set to True if ClamAV is installed
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# FFmpeg
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_THREADS=2

# Feature Flags
ENABLE_VIDEO_STREAMING=True
ENABLE_AI_INTROS=True
REQUIRE_EMAIL_VERIFICATION=False

# Email (for future use)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-password
