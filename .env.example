# Flask Configuration
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///ai_radio.db
# For PostgreSQL: postgresql://user:password@localhost/ai_radio

# Redis Configuration (for Celery and rate limiting)
REDIS_URL=redis://localhost:6379/0

# File Storage Paths (relative to project root)
UPLOAD_FOLDER=./media/uploads
MEDIA_FOLDER=./media
PLAYLIST_DIR=./media/playlists
VIDEO_STREAM_DIR=./media/video_stream
HLS_DIR=./media/video_stream/hls

# Streaming Configuration
ICECAST_CONFIG=./config/icecast.xml
LIQUIDSOAP_CONFIG=./config/liquidsoap.liq

# AI Brain Configuration
AI_BRAIN_URL=http://localhost:8080

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Icecast Streaming Server Configuration
ICECAST_LOCATION=AI Radio Platform
ICECAST_ADMIN_EMAIL=admin@localhost
ICECAST_SOURCE_PASSWORD=ai_radio_source_2024
ICECAST_RELAY_PASSWORD=ai_radio_relay_2024
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=ai_radio_admin_2024
ICECAST_PORT=8000
ICECAST_BIND_ADDRESS=0.0.0.0
ICECAST_MOUNT=/stream
ICECAST_SOURCE_USER=source
ICECAST_STREAM_NAME=AI Radio - All AI Generated Content
ICECAST_STREAM_DESCRIPTION=24/7 stream of AI-generated music, podcasts, and video content
ICECAST_STREAM_URL=http://localhost:5000
ICECAST_GENRE=AI Generated Content
# Add any other secrets or config values here
